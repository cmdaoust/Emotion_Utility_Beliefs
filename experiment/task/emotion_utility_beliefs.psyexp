        <Param val="if (correct) {&amp;#10;    thisfb = &quot;Correct!&quot;;&amp;#10;    fbcol = &quot;green&quot;;&amp;#10;} else {&amp;#10;    thisfb = &quot;Incorrect!&quot;;&amp;#10;    fbcol = &quot;red&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
