        <Param val="psychoJS.window.mouseVisible = false;&amp;#10;low_image_path = &quot;slider_images_light/AS_unhappy_light.png&quot;;&amp;#10;high_image_path = &quot;slider_images_light/AS_happy_light.png&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#  Set variables for BIOPAC trigger code (disabled - no BIOPAC in this version)&amp;#10;#movie_pulse_started = False&amp;#10;#movie_pulse_ended = False&amp;#10;#movie_end_pulse_started = False&amp;#10;#movie_end_pulse_ended = False&amp;#10;&amp;#10;win.mouseVisible = False # Make mouse ivisible&amp;#10;&amp;#10;&amp;#10;#get trials vid from trial handler&amp;#10;current_video_path = vid_path&amp;#10;&amp;#10;#assign vid to movie component&amp;#10;#movieStim = preloaded_movies[current_video_path]&amp;#10;movieStim = current_video_path&amp;#10;#movieStim.play()&amp;#10;&amp;#10;condition_name = &quot;DownCondition&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="#Send trigger to Biopac indicating that the regulation instruction is being displayed&amp;#10;#if down_movie.status == STARTED and not movie_pulse_started:&amp;#10;    #win.callOnFlip(ser.write, str.encode('01'))&amp;#10;    #movie_pulse_start_time = globalClock.getTime()&amp;#10;    #movie_pulse_started = True&amp;#10;&amp;#10;#if movie_pulse_started and not movie_pulse_ended:&amp;#10;    #if globalClock.getTime() - movie_pulse_start_time &gt;= 0.005:&amp;#10;        #win.callOnFlip(ser.write, str.encode('00'))&amp;#10;        #movie_pulse_ended = True&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="#clear memory used by preloaded movies&amp;#10;#for video in preloaded_movies.values():&amp;#10;#for video in video_paths.values()&amp;#10; #   video.setAutoDraw(False)&amp;#10;  #  video.stop()&amp;#10;   # del video" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = true;&amp;#10;if (((video_stim_trial_counter % 8) === 0)) {&amp;#10;    attention_check_visible = false;&amp;#10;} else {&amp;#10;    attention_check_visible = true;&amp;#10;}&amp;#10;video_stim_trial_counter = (video_stim_trial_counter + 1);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#ser.write('RR'.encode('utf-8')) # reset port as closed&amp;#10;&amp;#10;# Store video path for this trial&amp;#10;#trial_data[video_stim_trial_counter] = {&amp;#10;    #&quot;condition&quot; : condition_name,&amp;#10;    #&quot;video_path&quot;: current_video_path,&amp;#10;    #&quot;valenceRating&quot;: &quot;&quot;,&amp;#10;    #&quot;arousalRating&quot;: &quot;&quot;,&amp;#10;    #&quot;arousalConfidence&quot;: &quot;&quot;,&amp;#10;    #&quot;effortRating&quot;: &quot;&quot;&amp;#10;#}   &amp;#10;&amp;#10;#if the trial counter is a mulitple of 8, make the attention check routine condition variable true.&amp;#10;if video_stim_trial_counter % 8 == 0:&amp;#10;    attention_check_visible = False&amp;#10;else:&amp;#10;    attention_check_visible = True&amp;#10;#count everytime the video trial routine is ended&amp;#10;video_stim_trial_counter = video_stim_trial_counter + 1&amp;#10;&amp;#10;#stop and rest movie and audio&amp;#10;#movieStim.stop()&amp;#10;#movieStim.seek(0)&amp;#10;#del movieStim" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
