    <Routine name="loop_order_code">
      <RoutineSettingsComponent name="loop_order_code" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="loop_order_code" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code_4" plugin="None">
        <Param val="#import os&amp;#10;&amp;#10;#loopOrder = &quot;ControlUpDown&quot;&amp;#10;#loopOrder = &quot;ControlDownUp&quot;&amp;#10;#loopOrder = &quot;UpDownControl&quot;&amp;#10;#loopOrder = &quot;UpControlDown&quot;&amp;#10;loopOrder = &quot;DownControlUp&quot;&amp;#10;#loopOrder = &quot;DownUpControl&quot;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="loopOrder = &quot;DownFirst&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# --- Automatic condition allocation ---&amp;#10;# Group (timing/strategy) and loopOrder come from the pre-shuffled list in&amp;#10;# data/allocation.csv (made once with scripts/make_allocation_list.py).&amp;#10;# Each new participant ID takes the next free row. Re-running the same ID on&amp;#10;# the same day reuses that row, so a crash or restart does not use up a slot.&amp;#10;import csv&amp;#10;import datetime&amp;#10;ORDERS = ['ControlUpDown', 'ControlDownUp', 'UpDownControl', 'UpControlDown', 'DownControlUp', 'DownUpControl']&amp;#10;GROUPS = ['timing', 'strategy']&amp;#10;alloc_path = os.path.join(_thisDir, 'data', 'allocation.csv')&amp;#10;pid = str(expInfo['participant']).strip()&amp;#10;if not pid:&amp;#10;    raise RuntimeError('The participant ID is empty. Run the experiment again and enter the ID.')&amp;#10;&amp;#10;if PILOTING:&amp;#10;    # pilot runs never use up a row&amp;#10;    group = str(randchoice(GROUPS))&amp;#10;    loopOrder = str(randchoice(ORDERS))&amp;#10;    alloc_slot = 'pilot'&amp;#10;else:&amp;#10;    if not os.path.exists(alloc_path):&amp;#10;        raise RuntimeError('Allocation list not found: ' + alloc_path + '. Do not create a new one. Tell Carmen.')&amp;#10;    with open(alloc_path, newline='', encoding='utf-8') as f:&amp;#10;        alloc_rows = list(csv.DictReader(f))&amp;#10;    alloc_fields = list(alloc_rows[0].keys())&amp;#10;    today = datetime.date.today().isoformat()&amp;#10;    mine = [r for r in alloc_rows if r['participant'] == pid]&amp;#10;    if mine:&amp;#10;        row = mine[0]&amp;#10;        if not row['claimed_at'].startswith(today):&amp;#10;            raise RuntimeError('Participant ID ' + pid + ' was already used on ' + row['claimed_at'] + '. Check the ID with the participant. If it is correct, tell Carmen.')&amp;#10;    else:&amp;#10;        free = [r for r in alloc_rows if not r['participant']]&amp;#10;        if not free:&amp;#10;            raise RuntimeError('The allocation list is full. Tell Carmen.')&amp;#10;        row = free[0]&amp;#10;        row['participant'] = pid&amp;#10;        row['claimed_at'] = datetime.datetime.now().isoformat(timespec='seconds')&amp;#10;        tmp_path = alloc_path + '.tmp'&amp;#10;        with open(tmp_path, 'w', newline='', encoding='utf-8') as f:&amp;#10;            w = csv.DictWriter(f, fieldnames=alloc_fields)&amp;#10;            w.writeheader()&amp;#10;            w.writerows(alloc_rows)&amp;#10;        os.replace(tmp_path, alloc_path)&amp;#10;    group = row['group']&amp;#10;    loopOrder = row['loopOrder']&amp;#10;    alloc_slot = row['slot']&amp;#10;&amp;#10;assert group in GROUPS, 'Unknown group: ' + str(group)&amp;#10;assert loopOrder in ORDERS, 'Unknown loopOrder: ' + str(loopOrder)&amp;#10;# saved as columns on every row of the data file&amp;#10;expInfo['group'] = group&amp;#10;expInfo['loopOrder'] = loopOrder&amp;#10;expInfo['allocation_slot'] = alloc_slot&amp;#10;&amp;#10;loopRepeat = 1&amp;#10;downRegReps = 1&amp;#10;upRegReps = 1&amp;#10;controlRegReps = 1&amp;#10;&amp;#10;# Create data file&amp;#10;&amp;#10;# Get participant ID&amp;#10;#participant_id = expInfo['participant']  &amp;#10;&amp;#10;# Define filename&amp;#10;#filename = f&quot;{participant_id}_data_output.csv&quot;&amp;#10;&amp;#10;# Create the file with a header if it doesn’t exist&amp;#10;#file_path = os.path.join(os.getcwd(), filename)&amp;#10;#if not os.path.exists(file_path):&amp;#10;    #with open(file_path, 'w') as file:&amp;#10;        #file.write(&quot;trial,condition,video_path,valenceRating,arousalRating,arousalConfidence,effortRating\n&quot;)  # Adjust headers as needed&amp;#10;&amp;#10;# Dictionary to store trial data before writing&amp;#10;#trial_data = {}&amp;#10;&amp;#10;# Assign Variables&amp;#10;valenceRating = &quot;&quot;&amp;#10;arousalRating = &quot;&quot;&amp;#10;arousalConfidence = &quot;&quot;&amp;#10;effortRating = &quot;&quot;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="//import * as serial from 'serial';&amp;#10;//ser = new serial.Serial(&quot;COM3&quot;, 115200, {&quot;timeout&quot;: 1, &quot;bytesize&quot;: 8, &quot;stopbits&quot;: 1});&amp;#10;//ser.open;&amp;#10;//ser.write(&quot;RR&quot;.encode());&amp;#10;loopRepeat = 1;&amp;#10;downRegReps = 1;&amp;#10;upRegReps = 1;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((loopOrder === &quot;UpFirst&quot;)) {&amp;#10;    if ((loopRepeat === 1)) {&amp;#10;        upRegReps = 1;&amp;#10;        downRegReps = 0;&amp;#10;    } else {&amp;#10;        if ((loopRepeat === 2)) {&amp;#10;            upRegReps = 0;&amp;#10;            downRegReps = 1;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;if ((loopOrder === &quot;DownFirst&quot;)) {&amp;#10;    if ((loopRepeat === 1)) {&amp;#10;        upRegReps = 0;&amp;#10;        downRegReps = 1;&amp;#10;    } else {&amp;#10;        if ((loopRepeat === 2)) {&amp;#10;            upRegReps = 1;&amp;#10;            downRegReps = 0;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if loopOrder == &quot;ControlUpDown&quot;:&amp;#10;    if loopRepeat == 1:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 1&amp;#10;    elif loopRepeat == 2:&amp;#10;        upRegReps = 1&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 3:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 1&amp;#10;        controlRegReps = 0&amp;#10;&amp;#10;elif loopOrder == &quot;ControlDownUp&quot;:&amp;#10;    if loopRepeat == 1:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 1&amp;#10;    elif loopRepeat == 2:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 1&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 3:&amp;#10;        upRegReps = 1&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 0&amp;#10;&amp;#10;elif loopOrder == &quot;UpDownControl&quot;:&amp;#10;    if loopRepeat == 1:&amp;#10;        upRegReps = 1&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 2:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 1&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 3:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 1&amp;#10;&amp;#10;elif loopOrder == &quot;UpControlDown&quot;:&amp;#10;    if loopRepeat == 1:&amp;#10;        upRegReps = 1&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 2:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 1&amp;#10;    elif loopRepeat == 3:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 1&amp;#10;        controlRegReps = 0&amp;#10;&amp;#10;elif loopOrder == &quot;DownControlUp&quot;:&amp;#10;    if loopRepeat == 1:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 1&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 2:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 1&amp;#10;    elif loopRepeat == 3:&amp;#10;        upRegReps = 1&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 0&amp;#10;&amp;#10;elif loopOrder == &quot;DownUpControl&quot;:&amp;#10;    if loopRepeat == 1:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 1&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 2:&amp;#10;        upRegReps = 1&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 0&amp;#10;    elif loopRepeat == 3:&amp;#10;        upRegReps = 0&amp;#10;        downRegReps = 0&amp;#10;        controlRegReps = 1" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_4" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
