        <Param val="#import serial&amp;#10;    &amp;#10;#ser = serial.Serial(&quot;COM3&quot;,115200, timeout=1, bytesize=8, stopbits=1) # This must alwaus be used before sending any triggers, it specifies the settings for the serial port.Exact settings should be customised to your specific port &amp;#10;#ser.open # Open the port&amp;#10;#ser.write('RR'.encode()) # Reset the port so that its ready for the first trigger" valType="extendedCode" updates="constant" name="Begin Experiment"/>
