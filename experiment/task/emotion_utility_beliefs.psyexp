      </RoutineSettingsComponent>
      <CodeComponent name="instruct_affect_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="top_low_pos = [(- 0.6), (- 0.03)];&amp;#10;top_high_pos = [0.6, (- 0.03)];&amp;#10;bottom_low_pos = [(- 0.6), (- 0.25)];&amp;#10;bottom_high_pos = [0.6, (- 0.25)];&amp;#10;top_slider_pos = [0, 0];&amp;#10;bottom_slider_pos = [0, (- 0.2)];&amp;#10;AR_low_image_pos = top_low_pos;&amp;#10;AR_high_image_pos = top_high_pos;&amp;#10;AR_slider_pos = top_slider_pos;&amp;#10;VR_low_image_pos = bottom_low_pos;&amp;#10;VR_high_image_pos = bottom_high_pos;&amp;#10;VR_slider_pos = bottom_slider_pos;&amp;#10;&amp;#10;// set random number generator for slider positioning&amp;#10;slider_pos_rand_generator = 1;&amp;#10;slider_order = (([0] * 60) + ([1] * 60));&amp;#10;util.shuffle(slider_order);&amp;#10;slider_order_item = slider_order[0];" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="document.body.style.cursor='auto'; // set mouse to visible&amp;#10;&amp;#10;// randomise the order the sliders are shown in&amp;#10;&amp;#10;if ((slider_pos_rand_generator === 1)) {&amp;#10;    AR_low_image_pos = top_low_pos;&amp;#10;    AR_high_image_pos = top_high_pos;&amp;#10;    AR_slider_pos = top_slider_pos;&amp;#10;    VR_low_image_pos = bottom_low_pos;&amp;#10;    VR_high_image_pos = bottom_high_pos;&amp;#10;    VR_slider_pos = bottom_slider_pos;&amp;#10;} else {&amp;#10;    if ((slider_pos_rand_generator === 0)) {&amp;#10;        AR_low_image_pos = bottom_low_pos;&amp;#10;        AR_high_image_pos = bottom_high_pos;&amp;#10;        AR_slider_pos = bottom_slider_pos;&amp;#10;        VR_low_image_pos = top_low_pos;&amp;#10;        VR_high_image_pos = top_high_pos;&amp;#10;        VR_slider_pos = top_slider_pos;&amp;#10;    }&amp;#10;}&amp;#10;slider_pos_rand_generator = slider_order_item;&amp;#10;all_qs_answered = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Reset marker colour&amp;#10;instruct_AR_slider.marker.color='white'&amp;#10;instruct_VA_slider.marker.color='white'&amp;#10;&amp;#10;all_qs_answered = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if instruct_AR_slider.getRating() is not None:&amp;#10;    instruct_AR_slider.marker.color='grey'&amp;#10;    &amp;#10;if instruct_VA_slider.getRating() is not None:&amp;#10;    instruct_VA_slider.marker.color='grey'&amp;#10;&amp;#10;if instruct_AR_slider.getRating() is not None and instruct_VA_slider.getRating() is not None:&amp;#10;    all_qs_answered = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// create variables to record slider ratings&amp;#10;AR_rating = AR_slider.getRating();&amp;#10;VR_rating = VR_slider.getRating();&amp;#10;&amp;#10;// If both sliders have been answered, then set the variable that controls when the &quot;continue button&quot; appears to be true&amp;#10;if (AR_rating) {&amp;#10;    if (VR_rating) {&amp;#10;        all_qs_answered = true;&amp;#10;    }  &amp;#10;}&amp;#10;&amp;#10;if (VR_rating) {&amp;#10;    if (AR_rating) {&amp;#10;        all_qs_answered = true;&amp;#10;    }  &amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="slider_order_item = (slider_order_item + 1);" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="instruct_affect_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="instruct_affect_rating_text" plugin="None">
