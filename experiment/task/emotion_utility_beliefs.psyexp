    <LoopInitiator loopType="TrialHandler" name="down_instructions">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'instructionText': &quot;Later in today's session, you will be asked to perform a cognitive task for which you will receive a financial reward if you perform well. Emotions can be helpful in some circumstances but not in others. Researchers have found that experiencing intense emotions before engaging in this task can hinder performance. \n\nWhen we experience intense emotions, the body's heightened state of arousal releases adrenaline, which can disrupt our ability to focus on key elements of the task. This adrenaline rush can cause heightened anxiety, impaired decision-making, and difficulty concentrating, all of which can negatively impact your ability to perform well.&quot;}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$'instructions_' + group + '_down.xlsx'" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="down_instructions" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
