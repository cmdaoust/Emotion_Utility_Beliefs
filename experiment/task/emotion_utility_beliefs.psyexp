      <Param name="conditions" updates="None" val="[{'instructionText': &quot;Later in today's session, you will be asked to perform a cognitive task for which you will receive a financial reward if you perform well. Emotions can be helpful in some circumstances but not in others. Researchers have found that experiencing intense emotions before engaging in this task will not hinder or enhance performance. \n                                                                                                                                   &quot;}]" valType="str"/>
