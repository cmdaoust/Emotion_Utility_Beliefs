    <Routine name="effort_rating">
      <RoutineSettingsComponent name="effort_rating" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="effort_rating" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="effort_slider_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Prevent confidence question and continue button from being shown before affect rating is given&amp;#10;effort_slider_q_answered = False&amp;#10;effort_slider_allqs_answered = False&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="top_low_pos = [(- 0.6), (- 0.03)];&amp;#10;top_high_pos = [0.6, (- 0.03)];&amp;#10;bottom_low_pos = [(- 0.6), (- 0.25)];&amp;#10;bottom_high_pos = [0.6, (- 0.25)];&amp;#10;top_slider_pos = [0, 0];&amp;#10;bottom_slider_pos = [0, (- 0.2)];&amp;#10;AR_low_image_pos = top_low_pos;&amp;#10;AR_high_image_pos = top_high_pos;&amp;#10;AR_slider_pos = top_slider_pos;&amp;#10;VR_low_image_pos = bottom_low_pos;&amp;#10;VR_high_image_pos = bottom_high_pos;&amp;#10;VR_slider_pos = bottom_slider_pos;&amp;#10;&amp;#10;// set random number generator for slider positioning&amp;#10;slider_pos_rand_generator = 1;&amp;#10;slider_order = (([0] * 60) + ([1] * 60));&amp;#10;util.shuffle(slider_order);&amp;#10;slider_order_item = slider_order[0];" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="document.body.style.cursor='auto'; // set mouse to visible&amp;#10;&amp;#10;// randomise the order the sliders are shown in&amp;#10;&amp;#10;if ((slider_pos_rand_generator === 1)) {&amp;#10;    AR_low_image_pos = top_low_pos;&amp;#10;    AR_high_image_pos = top_high_pos;&amp;#10;    AR_slider_pos = top_slider_pos;&amp;#10;    VR_low_image_pos = bottom_low_pos;&amp;#10;    VR_high_image_pos = bottom_high_pos;&amp;#10;    VR_slider_pos = bottom_slider_pos;&amp;#10;} else {&amp;#10;    if ((slider_pos_rand_generator === 0)) {&amp;#10;        AR_low_image_pos = bottom_low_pos;&amp;#10;        AR_high_image_pos = bottom_high_pos;&amp;#10;        AR_slider_pos = bottom_slider_pos;&amp;#10;        VR_low_image_pos = top_low_pos;&amp;#10;        VR_high_image_pos = top_high_pos;&amp;#10;        VR_slider_pos = top_slider_pos;&amp;#10;    }&amp;#10;}&amp;#10;slider_pos_rand_generator = slider_order_item;&amp;#10;all_qs_answered = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Make mouse visibe&amp;#10;mouse = event.Mouse(visible=True)&amp;#10;&amp;#10;# Reset marker colour&amp;#10;effort_slider.marker.color='white'&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Changes marker colours&amp;#10;if effort_slider.getRating() is not None:&amp;#10;    effortRating = effort_slider.getRating()&amp;#10;    effort_slider.marker.color='grey'&amp;#10;    effort_slider_allqs_answered = True #Show the continue button as soon as a response has been given&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="// create variables to record slider ratings&amp;#10;AR_rating = AR_slider.getRating();&amp;#10;VR_rating = VR_slider.getRating();&amp;#10;&amp;#10;// If both sliders have been answered, then set the variable that controls when the &quot;continue button&quot; appears to be true&amp;#10;if (AR_rating) {&amp;#10;    if (VR_rating) {&amp;#10;        all_qs_answered = true;&amp;#10;    }  &amp;#10;}&amp;#10;&amp;#10;if (VR_rating) {&amp;#10;    if (AR_rating) {&amp;#10;        all_qs_answered = true;&amp;#10;    }  &amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="slider_order_item = (slider_order_item + 1);" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#trial_data[video_stim_trial_counter][&quot;effortRating&quot;] = effortRating&amp;#10;&amp;#10;# Write to file now that we have all data for the trial&amp;#10;#with open(file_path, 'a') as file:&amp;#10;    #file.write(f&quot;{video_stim_trial_counter},{trial_data[video_stim_trial_counter]['condition']},{trial_data[video_stim_trial_counter]['video_path']},{trial_data[video_stim_trial_counter]['valenceRating']},{trial_data[video_stim_trial_counter]['arousalRating']},{trial_data[trials.thisN]['arousalConfidence']},{trial_data[video_stim_trial_counter]['effortRating']}\n&quot;)&amp;#10;&amp;#10;# Remove trial from dictionary after writing&amp;#10;#del trial_data[video_stim_trial_counter]&amp;#10;&amp;#10;&amp;#10;effort_slider_allqs_answered = False&amp;#10;effort_slider_q_answered = False" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="effort_slider_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="affect_slider_question_text_2" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
