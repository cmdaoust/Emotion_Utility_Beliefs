    <LoopInitiator loopType="TrialHandler" name="up_instructions">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'instructionText': &quot;Later in today's session, you will be asked to perform a cognitive task for which you will receive a financial reward if you perform well. Emotions can be helpful in some circumstances but not in others. Researchers have found that experiencing intense emotions before engaging in this task can enhance performance. \n\nWhen we experience intense emotions, the body's heightened state of arousal releases adrenaline, which can sharpen our ability to focus on key elements of the task. This adrenaline surge can lead to increased alertness, quicker reflexes, and heightened concentration, all of which can positively impact your ability to perform well. &quot;}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$'instructions_' + group + '_up.xlsx'" valType="file"/>
